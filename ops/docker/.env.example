# Copy to .env (gitignored) in this folder and fill it in; docker compose reads it from here.

# The public name or IP address browsers use to reach coturn, e.g. turn.example.com.
TURN_HOST=
# Shared by e2ft and coturn, at least 32 characters, e.g. from `openssl rand -base64 32`.
TURN_SECRET=
# coturn's public address, only when the host is behind NAT.
EXTERNAL_IP=

# Optional. A published image instead of building this checkout, e.g. ghcr.io/<owner>/e2ft:<version>.
E2FT_IMAGE=
# Optional. Where the app listens on the host; default 127.0.0.1:8080, for a reverse proxy on the same host.
E2FT_PUBLISH=
# Optional. Your reverse proxy's address as the app sees it, for same-network discovery (see the README).
TRUSTED_PROXIES=
