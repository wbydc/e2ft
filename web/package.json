{
  "name": "e2ft-web",
  "version": "0.14.9",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "rm -rf dist && mkdir -p dist && cp -r public/. dist/ && node scripts/build.mjs",
    "serve": "npm run build && cd .. && cargo run",
    "check": "npm run typecheck && npm run fmt:check && npm run lint && npm run style && npm test",
    "typecheck": "tsc --noEmit",
    "fmt:check": "oxfmt --check",
    "style": "node scripts/check-style.mjs src tests",
    "test": "node --experimental-transform-types --disable-warning=ExperimentalWarning --test 'src/**/*.test.ts'",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives",
    "fmt": "oxfmt",
    "e2e": "playwright test",
    "integration": "playwright test --config playwright.integration.config.ts"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "jsqr": "1.4.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "^5.9.0"
  }
}
